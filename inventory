all:
  children:
    WebServers:
      hosts:
        web1:
          ansible_host: 172.31.90.174
          ansible_user: ansible_user
          ansible_ssh_private_key_file: /home/ubuntu/.ssh/id_ecdsa
          ansible_python_interpreter: /usr/bin/python3
          ansible_become_password: "{{ web1_pass }}"
        web2:
          ansible_host: 172.31.28.171
          ansible_user: ansible_user2
          ansible_ssh_private_key_file: /home/ubuntu/.ssh/id_rsa
          ansible_python_interpreter: /usr/bin/python3
          ansible_become_password: "{{ web2_pass }}"
